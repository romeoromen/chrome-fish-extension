{
  "manifest_version": 3,
  "name": "Fish Calendar",
  "version": "1.0.0",
  "description": "Googleカレンダーの予定5分前に魚群が泳ぐ",
  "permissions": ["identity", "alarms", "tabs", "activeTab", "storage"],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/fish.js"],
      "css": ["content/fish.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fish Calendar",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "oauth2": {
    "client_id": "948595714222-mk3thnitqp1gq4ocrks7samcfr1scj9l.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fish.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
